<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient1">

    <TextView android:id="@+id/labelTop" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⚡ TEMA JAM KEREN PRO ⚡" android:textColor="#00FFD1" android:textSize="11sp" android:letterSpacing="0.3"
        android:alpha="0.7" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="24dp"/>

    <LinearLayout android:id="@+id/clockBox" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <TextClock android:id="@+id/clockHour" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:text="21:34" android:textSize="90sp" android:textColor="#FFFFFF"
            android:fontFamily="monospace" android:textStyle="bold" android:shadowColor="#00FFD1"
            android:shadowDx="0" android:shadowDy="0" android:shadowRadius="20"/>

        <TextClock android:id="@+id/clockSec" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour=":ss" android:text=":12" android:textSize="28sp" android:textColor="#00FFD1"
            android:fontFamily="monospace" android:layout_marginTop="-10dp" android:alpha="0.9"/>

        <View android:layout_width="80dp" android:layout_height="2dp" android:background="#00FFD1"
            android:alpha="0.6" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="EEEE" android:text="SENIN" android:textSize="20sp" android:textColor="#FFFFFF"
            android:letterSpacing="0.2"/>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="dd MMMM yyyy" android:text="12 Oktober 2026" android:textSize="15sp"
            android:textColor="#AAAAAA" android:layout_marginTop="6dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="24dp" android:gravity="center">

            <TextView android:id="@+id/battery" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔋 85%" android:textColor="#FFFFFF" android:textSize="13sp" android:alpha="0.7"
                android:padding="8dp" android:background="@drawable/circle_neon"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" • " android:textColor="#666" android:textSize="13sp"/>

            <TextView android:id="@+id/btnTheme" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" GANTI TEMA " android:textColor="#00FFD1" android:textSize="13sp"
                android:padding="8dp" android:background="@drawable/circle_neon"/>
        </LinearLayout>

    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Tap layar untuk ganti tema • Keep screen on" android:textColor="#666" android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
