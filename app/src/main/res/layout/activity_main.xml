<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A0E17">

    <TextView android:id="@+id/labelTop" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="⚡ TEMA JAM SULTAN 50MB ULTIMATE ⚡" android:textColor="#00FFD1" android:textSize="11sp"
        android:gravity="center" android:letterSpacing="0.3"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="16dp"/>

    <com.jam.theme.AnalogClockView android:id="@+id/analog" android:layout_width="180dp" android:layout_height="180dp"
        app:layout_constraintTop_toBottomOf="@id/labelTop" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="12dp"/>

    <LinearLayout android:id="@+id/clockBox" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/analog" app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <TextClock android:id="@+id/clockHour" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:text="21:34" android:textSize="88sp" android:textColor="#FFF"
            android:fontFamily="monospace" android:textStyle="bold" android:shadowColor="#00FFD1" android:shadowRadius="30"/>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour=":ss" android:text=":12" android:textSize="28sp" android:textColor="#00FFD1"
            android:fontFamily="monospace" android:layout_marginTop="-10dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <TextView android:id="@+id/stopwatch" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏱️ 00:00.0" android:textColor="#FFF" android:textSize="13sp" android:padding="10dp"
                android:background="@drawable/circle_neon" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏳ 05:00" android:textColor="#FFD700" android:textSize="13sp" android:padding="10dp"
                android:background="@drawable/circle_neon"/>
        </LinearLayout>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="EEEE, dd MMMM yyyy" android:text="Senin, 12 Okt 2026" android:textSize="13sp"
            android:textColor="#AAA" android:layout_marginTop="10dp"/>

        <TextView android:id="@+id/extraInfo" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="Loading..." android:textColor="#666" android:textSize="10sp" android:gravity="center"
            android:layout_marginTop="6dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/bottomBar" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/battery" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔋 85% 🌡️ 32°C" android:textColor="#FFF" android:textSize="11sp" android:padding="10dp"
            android:background="@drawable/circle_neon" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/btnTheme" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" 🎨 GANTI TEMA SULTAN (7) " android:textColor="#00FFD1" android:textSize="11sp"
            android:padding="10dp" android:background="@drawable/circle_neon"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
