<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A0E17">

    <TextView android:id="@+id/labelTop" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⚡ TEMA JAM KEREN PRO MAX ⚡" android:textColor="#00FFD1" android:textSize="11sp" android:letterSpacing="0.3"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="20dp"/>

    <com.jam.theme.AnalogClockView android:id="@+id/analog" android:layout_width="160dp" android:layout_height="160dp"
        app:layout_constraintTop_toBottomOf="@id/labelTop" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="16dp"/>

    <LinearLayout android:id="@+id/clockBox" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/analog" app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <TextClock android:id="@+id/clockHour" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:text="21:34" android:textSize="82sp" android:textColor="#FFF"
            android:fontFamily="monospace" android:textStyle="bold" android:shadowColor="#00FFD1"
            android:shadowRadius="25" android:shadowDx="0" android:shadowDy="0"/>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour=":ss" android:text=":12" android:textSize="26sp" android:textColor="#00FFD1"
            android:fontFamily="monospace" android:layout_marginTop="-8dp"/>

        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="EEEE, dd MMMM yyyy" android:text="Senin, 12 Oktober 2026"
            android:textSize="14sp" android:textColor="#AAA" android:layout_marginTop="12dp"/>

        <TextView android:id="@+id/stopwatch" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⏱️ 00:00.0" android:textSize="16sp" android:textColor="#FFF" android:alpha="0.8"
            android:padding="10dp" android:layout_marginTop="12dp"
            android:background="@drawable/circle_neon"/>

        <TextView android:id="@+id/extraInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="RAM OK • PRO MAX" android:textColor="#666" android:textSize="10sp" android:layout_marginTop="8dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/bottomBar" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:id="@+id/battery" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔋 85% 🌡️ 32°C" android:textColor="#FFF" android:textSize="12sp"
            android:padding="10dp" android:background="@drawable/circle_neon" android:layout_marginEnd="12dp"/>

        <TextView android:id="@+id/btnTheme" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" 🎨 GANTI TEMA " android:textColor="#00FFD1" android:textSize="12sp" android:padding="10dp"
            android:background="@drawable/circle_neon"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
